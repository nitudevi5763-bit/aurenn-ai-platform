# Copy this file to .env.local for local testing, and add the SAME
# values inside Vercel -> Project Settings -> Environment Variables for
# the live site. Never commit a file with real values in it to GitHub.

# From Supabase: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# From Supabase: Project Settings -> API -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# From Supabase: Project Settings -> API -> Secret key (sb_secret_...)
# Server-side only. Never put NEXT_PUBLIC_ in front of this one.
SUPABASE_SECRET_KEY=
